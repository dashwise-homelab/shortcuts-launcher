{
  "name": "dashwise-desktop-launcher",
  "version": "0.1.0",
  "description": "Local shortcuts for Dashwise and Home Assistant",
  "license": "AGPL-3.0-only",
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "mqtt": "^5.10.4",
    "sql.js": "^1.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.18.0",
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.dashwise.desktoplauncher",
    "productName": "Dashwise Desktop Launcher",
    "files": ["dist/**/*", "package.json"],
    "linux": {"target": ["AppImage", "deb"]},
    "mac": {"target": "dmg"},
    "win": {"target": "nsis"}
  }
}
