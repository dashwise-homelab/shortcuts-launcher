{
  "name": "dashwise-desktop-launcher",
  "version": "0.1.0",
  "description": "Local shortcuts for Dashwise and Home Assistant",
  "license": "AGPL-3.0-only",
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs v0.1",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"scripts/**/*.mjs\" package.json tsconfig.json pnpm-workspace.yaml README.md .prettierrc",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\" \"scripts/**/*.mjs\" package.json tsconfig.json pnpm-workspace.yaml README.md .prettierrc",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "mqtt": "^5.10.4",
    "sql.js": "^1.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.18.0",
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.4",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.dashwise.desktoplauncher",
    "productName": "Dashwise Shortcuts Launcher (Desktop)",
    "icon": "src/renderer/assets/dashwise-icon.png",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
